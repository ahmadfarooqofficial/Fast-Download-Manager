{
  "manifest_version": 3,
  "name": "FDM — Fast Download Manager",
  "short_name": "FDM",
  "version": "0.1.0",
  "description": "Takes over your browser downloads and fetches them with parallel connections through the FDM desktop app.",
  "author": "Ahmad Farooq",
  "homepage_url": "https://github.com/ahmadfarooq/fdm",

  "minimum_chrome_version": "116",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "FDM — Fast Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "storage",
    "notifications"
  ],

  "host_permissions": ["http://*/*", "https://*/*"],

  "web_accessible_resources": []
}
